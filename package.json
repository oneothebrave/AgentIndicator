{
  "name": "agent-indicator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/indicator.mjs",
    "doctor": "node scripts/indicator.mjs --check",
    "session:reset": "node scripts/indicator.mjs --reset-session",
    "stability": "node scripts/stability.mjs",
    "dev": "vite --host 127.0.0.1",
    "bridge": "tsx server/index.ts",
    "bridge:mock": "tsx server/index.ts",
    "bridge:codex": "tsx server/index.ts",
    "bridge:cli": "tsx server/cli.ts",
    "hooks:install": "node scripts/install-codex-hooks.mjs",
    "test": "node --import tsx --test server/statusBroadcaster.test.ts server/sources/codex/events.test.ts server/sources/hooks/*.test.ts scripts/indicator.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}

